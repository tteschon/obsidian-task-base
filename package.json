{
	"name": "obsidian-task-base",
	"version": "0.3.2",
	"description": "Create and manage note-per-task records with RRULE recurrence in Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsx --test test/*.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src test *.mjs"
	},
	"keywords": [
		"obsidian",
		"tasks",
		"rrule"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.10.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.69.0"
	},
	"dependencies": {
		"rrule": "^2.8.1"
	}
}
